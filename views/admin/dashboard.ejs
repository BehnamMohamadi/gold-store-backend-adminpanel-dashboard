<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  >

  <title>
    <%= title %> | XXXX GOLD
  </title>

  <link
    rel="stylesheet"
    href="/css/admin/admin.css"
  >
</head>

<body>
  <div class="admin-layout">
    <%- include("partials/sidebar", {
      activePage: "dashboard",
      adminUser
    }) %>

    <main class="admin-main">
      <%- include("partials/topbar", {
        pageTitle: "داشبورد مدیریت",
        pageSubtitle: "نمای کلی فروشگاه و وضعیت فعلی کسب‌وکار"
      }) %>

      <section class="metric-grid dashboard-metrics">
        <article class="metric-card">
          <div class="metric-label">
            فروش پرداخت‌شده
          </div>

          <strong id="metricSales">
            —
          </strong>

          <small>
            مجموع سفارش‌های Paid
          </small>
        </article>

        <article class="metric-card">
          <div class="metric-label">
            سفارش‌ها
          </div>

          <strong id="metricOrders">
            —
          </strong>

          <small id="metricOrdersSub">
            —
          </small>
        </article>

        <article class="metric-card">
          <div class="metric-label">
            محصولات
          </div>

          <strong id="metricProducts">
            —
          </strong>

          <small id="metricProductsSub">
            —
          </small>
        </article>

        <article class="metric-card">
          <div class="metric-label">
            کاربران
          </div>

          <strong id="metricUsers">
            —
          </strong>

          <small id="metricUsersSub">
            —
          </small>
        </article>

        <article class="metric-card">
          <div class="metric-label">
            سبدهای خرید
          </div>

          <strong id="metricCarts">
            —
          </strong>

          <small>
            سبدهای موجود
          </small>
        </article>
      </section>

      <section class="dashboard-grid">
        <article class="panel">
          <div class="panel-head">
            <div>
              <h2>
                آخرین سفارش‌ها
              </h2>

              <p>
                جدیدترین سفارش‌های ثبت‌شده
              </p>
            </div>

            <a
              class="text-link"
              href="/admin/orders"
            >
              مشاهده همه
            </a>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>شماره</th>
                  <th>مشتری</th>
                  <th>مبلغ</th>
                  <th>سفارش</th>
                  <th>پرداخت</th>
                </tr>
              </thead>

              <tbody id="latestOrdersBody"></tbody>
            </table>
          </div>
        </article>

        <article class="panel gold-panel">
          <div class="panel-head">
            <div>
              <h2>
                قیمت فعلی طلا
              </h2>
            </div>

            <a
              class="text-link"
              href="/admin/gold-pricing"
            >
              ویرایش
            </a>
          </div>

          <div class="gold-price-list">
            <div>
              <span>۱۸ عیار</span>
              <strong id="gold18">—</strong>
            </div>

            <div>
              <span>۲۱ عیار</span>
              <strong id="gold21">—</strong>
            </div>

            <div>
              <span>۲۲ عیار</span>
              <strong id="gold22">—</strong>
            </div>

            <div>
              <span>۲۴ عیار</span>
              <strong id="gold24">—</strong>
            </div>
          </div>

          <div class="gold-meta">
            <span>
              سود:
              <b id="profitPercent">—</b>
            </span>

            <span>
              مالیات:
              <b id="taxPercent">—</b>
            </span>

            <span>
              آخرین بروزرسانی:
              <b id="pricingUpdatedAt">—</b>
            </span>
          </div>
        </article>
      </section>

      <section class="dashboard-grid bottom">
        <article class="panel">
          <div class="panel-head">
            <div>
              <h2>
                محصولات کم‌موجودی
              </h2>

              <p>
                موجودی ۳ عدد یا کمتر
              </p>
            </div>

            <a
              class="text-link"
              href="/admin/products"
            >
              محصولات
            </a>
          </div>

          <div
            id="lowStockList"
            class="compact-list"
          ></div>
        </article>

        <article class="panel">
          <div class="panel-head">
            <div>
              <h2>
                وضعیت فروشگاه
              </h2>
            </div>
          </div>

          <div class="status-summary">
            <div>
              <span class="status-dot success"></span>
              <span>کاربران فعال</span>
              <strong id="activeUsers">—</strong>
            </div>

            <div>
              <span class="status-dot warning"></span>
              <span>سفارش‌های در انتظار</span>
              <strong id="pendingOrders">—</strong>
            </div>

            <div>
              <span class="status-dot danger"></span>
              <span>پرداخت‌نشده</span>
              <strong id="unpaidOrders">—</strong>
            </div>

            <div>
              <span class="status-dot warning"></span>
              <span>محصول غیرفعال</span>
              <strong id="inactiveProducts">—</strong>
            </div>
          </div>
        </article>
      </section>
    </main>
  </div>

  <%- include("partials/scripts") %>

  <script src="/js/admin/dashboard.js"></script>
</body>
</html>
