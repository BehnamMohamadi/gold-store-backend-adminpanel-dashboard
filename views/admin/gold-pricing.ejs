<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | XXXX GOLD</title>
  <link rel="stylesheet" href="/css/admin/admin.css">
</head>
<body >
  <div class="admin-layout">
    <%- include("partials/sidebar", { activePage: "pricing", adminUser }) %>
    <main class="admin-main">
      <%- include("partials/topbar", { pageTitle: "قیمت طلا", pageSubtitle: "قیمت‌های پایه‌ای که در Pricing Service استفاده می‌شوند" }) %>
      
<section class="pricing-cards">
  <article class="price-card"><span>طلای ۱۸ عیار</span><strong id="cardGold18">—</strong><small>تومان / گرم</small></article>
  <article class="price-card"><span>طلای ۲۱ عیار</span><strong id="cardGold21">—</strong><small>تومان / گرم</small></article>
  <article class="price-card"><span>طلای ۲۲ عیار</span><strong id="cardGold22">—</strong><small>تومان / گرم</small></article>
  <article class="price-card"><span>طلای ۲۴ عیار</span><strong id="cardGold24">—</strong><small>تومان / گرم</small></article>
</section>

<section class="split-grid pricing-form-grid">
  <article class="panel">
    <div class="panel-head"><div><h2>تنظیم قیمت عمومی</h2><p>Singleton: GoldPricing / key=main</p></div></div>
    <form id="goldPricingForm" class="form-grid">
      <label class="field"><span>قیمت ۱۸ عیار</span><input type="number" min="0" name="gold18"></label>
      <label class="field"><span>قیمت ۲۱ عیار</span><input type="number" min="0" name="gold21"></label>
      <label class="field"><span>قیمت ۲۲ عیار</span><input type="number" min="0" name="gold22"></label>
      <label class="field"><span>قیمت ۲۴ عیار</span><input type="number" min="0" name="gold24"></label>
      <label class="field"><span>درصد سود پیش‌فرض</span><input type="number" min="0" step="0.01" name="profitPercent"></label>
      <label class="field"><span>درصد مالیات</span><input type="number" min="0" step="0.01" name="taxPercent"></label>
      <label class="field full"><span>منبع</span><input name="source"></label>
      <div class="full"><button class="btn btn-gold">بروزرسانی قیمت‌ها</button></div>
    </form>
  </article>

  <article class="panel">
    <div class="panel-head"><div><h2>اطلاعات بروزرسانی</h2><p>Metadata</p></div></div>
    <dl class="meta-list">
      <div><dt>کلید</dt><dd id="pricingKey">—</dd></div>
      <div><dt>منبع</dt><dd id="pricingSource">—</dd></div>
      <div><dt>بروزرسانی توسط</dt><dd id="pricingUpdatedBy">—</dd></div>
      <div><dt>آخرین بروزرسانی</dt><dd id="pricingUpdated">—</dd></div>
    </dl>
  </article>
</section>

    </main>
  </div>
  <%- include("partials/scripts") %>
  <script src="/js/admin/gold-pricing.js"></script>
</body>
</html>