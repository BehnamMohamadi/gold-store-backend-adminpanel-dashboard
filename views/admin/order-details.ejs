<!doctype html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="utf-8">

  <meta name="viewport" content="width=device-width,initial-scale=1">

  <title>
    <%= title %> | XXXX GOLD
  </title>

  <link rel="stylesheet" href="/css/admin/admin.css">
</head>

<body>
  <div class="admin-layout">
    <%- include("partials/sidebar", { activePage: "orders" , adminUser }) %>

      <main class="admin-main">
        <%- include("partials/topbar", { pageTitle: "جزئیات سفارش" ,
          pageSubtitle: "اطلاعات سفارش، پرداخت‌ها و سابقه بررسی ادمین" }) %>

          <div id="orderDetailsPage" data-order-id="<%= orderId %>"></div>

          <section class="order-top-grid">
            <article class="panel">
              <div class="panel-head">
                <div>
                  <h2>
                    اطلاعات سفارش
                  </h2>
                </div>
              </div>

              <dl class="meta-list" id="orderMeta"></dl>
            </article>

            <article class="panel">
              <div class="panel-head">
                <div>
                  <h2>
                    اطلاعات مشتری
                  </h2>
                </div>
              </div>

              <dl class="meta-list" id="customerMeta"></dl>
            </article>

            <article class="panel">
              <div class="panel-head">
                <div>
                  <h2>
                    مدیریت سفارش
                  </h2>

                  <p class="muted">
                    وضعیت پرداخت و Review توسط Payment Service کنترل می‌شوند.
                  </p>
                </div>
              </div>

              <form id="orderStatusForm" class="stack-form">
                <label class="field">
                  <span>
                    وضعیت سفارش
                  </span>

                  <select name="status">
                    <option value="pending">
                      در انتظار
                    </option>

                    <option value="payment_pending" disabled>
                      در حال پرداخت
                    </option>

                    <option value="review" disabled>
                      نیازمند بررسی
                    </option>

                    <option value="confirmed">
                      تأییدشده
                    </option>

                    <option value="cancelled">
                      لغوشده
                    </option>

                    <option value="expired">
                      منقضی‌شده
                    </option>
                  </select>
                </label>

                <div id="orderStatusLockMessage" class="note-box small hidden"></div>

                <button id="saveOrderStatus" class="btn btn-gold full-btn" type="submit">
                  ذخیره وضعیت سفارش
                </button>
              </form>
            </article>
          </section>

          <section class="panel order-address-panel hidden" id="shippingAddressPanel">
            <div class="panel-head">
              <div>
                <h2>
                  آدرس ارسال
                </h2>
              </div>
            </div>

            <div id="shippingAddress" class="shipping-address-box"></div>
          </section>

          <section class="panel">
            <div class="panel-head">
              <div>
                <h2>
                  تراکنش‌های پرداخت
                </h2>

                <p class="muted">
                  پرداخت‌ها، Review فعال و تاریخچه تصمیمات ادمین
                </p>
              </div>

              <a class="btn btn-ghost" href="/admin/payments">
                همه پرداخت‌ها
              </a>
            </div>

            <div id="paymentReviewMessage" class="hidden"></div>

            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>درگاه</th>
                    <th>مبلغ</th>
                    <th>وضعیت</th>
                    <th>Authority</th>
                    <th>Ref ID</th>
                    <th>بررسی</th>
                    <th>تاریخ</th>
                  </tr>
                </thead>

                <tbody id="paymentsBody">
                  <tr>
                    <td colspan="7">
                      در حال دریافت پرداخت‌ها...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <section class="panel">
            <div class="panel-head">
              <div>
                <h2>
                  اقلام سفارش
                </h2>
              </div>
            </div>

            <div class="order-items" id="orderItems"></div>
          </section>
      </main>
  </div>

  <%- include("partials/scripts") %>

    <script src="/js/admin/order-details.js"></script>
</body>

</html>